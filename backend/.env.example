# Used only by `node --env-file=backend/.env scripts/test-apis.js` (provider smoke test).
# Deployed stages AND `npm run offline` read secrets from SSM Parameter Store:
# /stockai/<stage>/<name> (see docs/DEPLOYMENT.md). Never commit real values.

# https://replicate.com/account/api-tokens
REPLICATE_API_KEY=
# https://newsapi.org/account
NEWS_API_KEY=
# Optional: override the Replicate model id
LLM_MODEL=ibm-granite/granite-3.3-8b-instruct
