# Public configuration only. These values are bundled into the browser,
# so NEVER put third-party API keys here. All data goes through our backend.

# Backend base URL including stage, e.g. https://xxxx.execute-api.us-east-1.amazonaws.com/dev
VITE_API_URL=http://localhost:3001/dev

# Cognito (public identifiers, not secrets)
VITE_AWS_REGION=us-east-1
VITE_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_USER_POOL_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
